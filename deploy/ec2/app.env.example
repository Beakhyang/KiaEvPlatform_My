SPRING_PROFILES_ACTIVE=prod
PORT=8080
SESSION_TIMEOUT=10m

DB_URL=jdbc:mysql://your-rds-endpoint:3306/kiaevdb?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

AWS_REGION=ap-northeast-2
AWS_SECRET_NAME=kiaev/prod/api-keys
CHATBOT_AI_MODEL=gemini-2.5-flash
JPA_DDL_AUTO=update
CHARGING_SYNC_ENABLED=false
# CHARGING_SYNC_TOKEN=replace_with_random_sync_token

# If you are not using AWS Secrets Manager yet, keep the direct keys below instead.
# KAKAO_API_KEY=your_kakao_api_key
# CHARGING_API_KEY=your_charging_api_key
# GEMINI_API_KEY=your_gemini_api_key
