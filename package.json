{
  "name": "kiaevplatform-e2e",
  "private": true,
  "scripts": {
    "e2e:install": "playwright install",
    "e2e:user": "playwright test -c e2e/playwright.config.ts",
    "e2e:user:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "e2e:demo:v2": "playwright test -c e2e/demo-v2.playwright.config.ts",
    "e2e:demo:v2:headed": "playwright test -c e2e/demo-v2.playwright.config.ts --headed",
    "e2e:demo:v2:guest": "playwright test -c e2e/demo-v2.playwright.config.ts --grep @guest --headed",
    "e2e:demo:v2:member": "playwright test -c e2e/demo-v2.playwright.config.ts --grep @member --headed",
    "e2e:demo:v2:report": "playwright show-report test-v2/report",
    "e2e:report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "dotenv": "^16.4.7",
    "mysql2": "^3.11.5"
  }
}
